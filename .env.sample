# Portable data dir (exe-adjacent ./data by default for frozen builds, cwd for source runs).
# Set this to keep settings/DB/logs on a NAS volume or custom path.
# RMT_DATA_DIR=./data

# Real-Debrid API Key (Get from https://real-debrid.com/apitoken)
# Optional on first boot: leave empty and complete setup in the web UI (POST /api/setup).
RD_API_KEY=

# Full path to the folder where files should be downloaded on the server
# Defaults to <data_dir>/downloads when empty.
# DOWNLOAD_FOLDER=

# Optional: Host, Port, and Reload for the server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
RELOAD=False
# Optional: pinned version string baked into exe builds (RMT_VERSION=0.1.0)
# RMT_VERSION=dev
# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional shared household UI password
APP_PASSWORD=

# Optional webhook notifications (comma-separated events)
WEBHOOK_URL=
WEBHOOK_TOKEN=
# download.started, download.paused, download.resumed, download.rd_completed, download.completed, download.failed, download.cancelled
WEBHOOK_EVENTS=download.completed

# Optional Torrentio discovery configuration
TORRENTIO_URL=https://torrentio.strem.fun
# Example: sort=qualitysize|qualityfilter=threed,other,scr,cam,unknown|realdebrid=YOUR_RD_KEY
TORRENTIO_FILTER=

# Optional Prowlarr discovery configuration
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
PROWLARR_RESULT_LIMIT=20

# Optional local-download tuning (headless/exe friendly)
# CHUNK_SIZE=1048576
# MAX_MBPS=0
# MIN_FREE_BYTES=1073741824
