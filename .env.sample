# Real-Debrid API Key (Get from https://real-debrid.com/apitoken)
RD_API_KEY=API_KEY

# Full path to the folder where files should be downloaded on the server
DOWNLOAD_FOLDER=Folder

# Optional: Host, Port, and Reload for the server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
RELOAD=False

# Optional shared household UI password
APP_PASSWORD=

# Optional webhook notifications (comma-separated events)
WEBHOOK_URL=
WEBHOOK_TOKEN=
# download.started, download.paused, download.resumed, download.rd_completed, download.completed, download.failed, download.cancelled
WEBHOOK_EVENTS=download.completed
